<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Aucune permission réseau : Lunaison fonctionne entièrement hors ligne.
        Autorisations facultatives :
        - notifications, demandée quand la personne active un rappel ;
        - caméra, demandée uniquement si la personne ouvre le lecteur de QR Code partenaire ;
        - lecture des règles dans Health Connect (READ_MENSTRUATION), demandée uniquement quand la personne
          choisit d'importer depuis Health Connect, avec l'accès facultatif à l'historique
          (READ_HEALTH_DATA_HISTORY). Lecture seule : aucune permission d'écriture.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <!-- Historique Health Connect (lecture seule, facultatif) : sans lui, seuls les 30 derniers jours sont lisibles. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- Messageries vers lesquelles le partage peut ouvrir directement la conversation. -->
    <queries>
        <!-- Health Connect : nécessaire pour savoir s'il est installé (visibilité des paquets). -->
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.thoughtcrime.securesms" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <!-- Pas de sauvegarde dans le nuage. Seul le transfert direct vers un nouveau téléphone est permis (voir data_extraction_rules). -->
    <application
        android:name=".LunaisonApplication"
        android:allowBackup="${allowAutoBackup}"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lunaison">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Justification des permissions Health Connect : écran d'explication, sans accès aux données. -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14 et plus : Health Connect ouvre cette cible par VIEW_PERMISSION_USAGE. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Partage du bilan de santé en PDF : fichier du cache lu par l'appli choisie, sans permission ni réseau. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fichiers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Actions des notifications (règles commencées, prise faite) : interne à l'appli. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.LunaisonWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lunaison_widget_info" />
        </receiver>

    </application>
</manifest>
