<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de sauvegarde Android 12 et plus. Avant Android 12, android:fullBackupContent="false" coupe toute sauvegarde.
    allowBackup reste actif : avec false, ni le transfert direct ni la copie dans le compte Google ne fonctionnent.

    Une seule chose peut quitter l'appli par le système : le dossier privé « sauvegarde-privee » (domaine file),
    qui ne contient que le DERNIER fichier .pilmil, déjà chiffré par la phrase secrète de la personne
    (documentation/chiffrement.md, section « Si le téléphone est perdu »). Dès qu'une règle <include> existe, tout le
    reste est exclu : ni la base chiffrée, ni la clé enveloppée (lunaison_cle_base.xml), ni la phrase enveloppée
    (lunaison_phrase_sauvegarde.xml), ni les réglages. Copiées ailleurs, la base et les clés seraient de toute façon
    illisibles : elles restent liées au Keystore de ce téléphone.

    - cloud-backup : LunaisonBackupAgent ne laisse rien partir sauf si la personne a activé la copie dans son compte
      Google, qu'une phrase secrète existe, et qu'Android chiffre la copie de bout en bout (disableIfNoEncryptionCapabilities).
    - device-transfer : le transfert direct vers un nouveau téléphone est toujours permis, avec ce même seul fichier.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="sauvegarde-privee" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="sauvegarde-privee" />
    </device-transfer>
</data-extraction-rules>
