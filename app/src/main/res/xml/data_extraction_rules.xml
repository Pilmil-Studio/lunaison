<?xml version="1.0" encoding="utf-8"?>
<!--
    Rien n'est sauvegardé dans le nuage : les données de santé ne passent jamais par un serveur.
    Le transfert direct vers un nouveau téléphone (câble ou sans fil, au moment de sa configuration)
    reste autorisé pour les préférences, mais plus pour la base chiffrée (voir plus bas).
    Ces règles s'appliquent à partir d'Android 12. Avant, android:fullBackupContent="false" coupe toute sauvegarde.
    allowBackup reste actif : avec false, le transfert direct peut être bloqué selon les constructeurs.

    Base chiffrée (documentation/chiffrement.md) : la base et sa clé enveloppée ne partent dans AUCUNE
    sauvegarde ni AUCUN transfert. La clé qui les ouvre reste dans le Keystore de ce téléphone et ne peut
    pas en sortir : copiées ailleurs, elles seraient illisibles. Pour changer de téléphone, la sauvegarde
    chiffrée .pilmil (Réglages, Données) emporte tout le journal.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" />
        <include domain="file" />
        <exclude domain="sharedpref" path="lunaison_cle_base.xml" />
    </device-transfer>
</data-extraction-rules>
